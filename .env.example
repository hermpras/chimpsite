# Environment Variables Example for ChimpHood Site
# Copy this file to .env.local for local development

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chimphood_dev?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Pending final spec: NextAuth / SIWE / Iron Session)
# AUTH_SECRET="your-32-character-secret-placeholder"
# NEXTAUTH_URL="http://localhost:3000"

# Wallet Connection (Pending final spec: WalletConnect Cloud Project ID)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="your-walletconnect-project-id"

# X (Twitter) OAuth 2.0 (Pending final spec)
# X_CLIENT_ID="your-x-oauth-client-id"
# X_CLIENT_SECRET="your-x-oauth-client-secret"

# Admin API Key / Internal Secrets (Placeholder)
# ADMIN_API_KEY="your-admin-api-key-placeholder"
