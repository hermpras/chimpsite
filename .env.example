# =============================================================================
# ChimpHood Site — Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or sensitive credentials to source control.
# See docs/environment-variables.md for comprehensive documentation and guides.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database Configuration (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM v7.
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chimphood_dev?schema=public"

# -----------------------------------------------------------------------------
# 2. Public Application Base URL (Optional / Recommended)
# -----------------------------------------------------------------------------
# Public base URL of the application. Used for client-side links and canonical URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 3. Session & Authentication Secrets (Required for Auth & Admin Session)
# -----------------------------------------------------------------------------
# Iron Session cookie encryption secret.
# Must be at least 32 characters long.
# Generate a cryptographically secure key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-secure-32-plus-character-secret-key-012345"

# -----------------------------------------------------------------------------
# 4. Sign-In with Ethereum (SIWE / EIP-4361) Configuration (Required for SIWE)
# -----------------------------------------------------------------------------
# SIWE_DOMAIN and SIWE_URI are required by POST /api/auth/verify and fail closed
# if unset. For local development, include the exact port (e.g., localhost:3000).
# In production, use the production domain and canonical origin.
SIWE_DOMAIN="localhost:3000"
SIWE_URI="http://localhost:3000"

# Comma-separated EVM chain IDs accepted for login (optional, defaults to "1" for Ethereum Mainnet).
# Example for multiple chains: ALLOWED_CHAIN_IDS="1,11155111"
ALLOWED_CHAIN_IDS="1"

# -----------------------------------------------------------------------------
# 5. X (Twitter) OAuth 2.0 PKCE Configuration (Required for Social Linking)
# -----------------------------------------------------------------------------
# Required for X account verification (/api/social/x/*). Fails closed (503)
# when unconfigured without breaking other features (DEC-003).
# Create credentials in the Twitter Developer Portal (OAuth 2.0 User Authentication).
#
# X_CLIENT_ID="your-x-oauth2-client-id"
# X_CLIENT_SECRET="your-x-oauth2-client-secret"
# X_REDIRECT_URI="http://localhost:3000/api/social/x/callback"

# -----------------------------------------------------------------------------
# 6. Cron Job Authorization (Required for Automated Background Jobs)
# -----------------------------------------------------------------------------
# Bearer secret used to authorize invocation of automated background endpoints.
# Required by all cron routes:
#   - /api/cron/sweep-gifts      (Task 2-A — hourly gift expiry sweep)
#   - /api/cron/cleanup-auth     (Task 2-C — every 15 min auth nonce/session cleanup)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET="replace-with-a-secure-cron-secret-token"

# -----------------------------------------------------------------------------
# 7. Distributed Rate Limiting (Upstash Redis) (Required for Serverless / Prod)
# -----------------------------------------------------------------------------
# REST credentials for shared distributed rate limiting via Upstash Redis (Task 0-C).
# Used by lib/auth/rate-limit.ts. Fails closed (500) if unset.
# Create a serverless Redis database at: https://console.upstash.com
#
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-redis-rest-token"

# -----------------------------------------------------------------------------
# 8. Initial Super Admin Bootstrap (Task B-3 — Staging & Production Setup)
# -----------------------------------------------------------------------------
# EVM wallet address for initial SUPER_ADMIN role bootstrap.
# Executed via isolated CLI script: npm run admin:bootstrap
# INITIAL_SUPER_ADMIN_ADDRESS="0x0000000000000000000000000000000000000000"
